# load_csv（CSV 匯入工具）的連線設定範本。
# 複製成 .env 放在 load_csv.exe 旁邊。.env 不進版控（見 .gitignore）。
# 也可以不準備這個檔：直接點兩下 load_csv.exe，它會一步一步問，最後幫你存成 .env（不存密碼）。
#
# 優先順序：命令列參數 > 這個檔 > 互動詢問。

# 伺服器。地端：主機名稱或IP,1433；雲端 Azure SQL：xxx.database.windows.net
SQL_SERVER=主機名稱或IP,1433
SQL_DATABASE=資料庫名稱

# 驗證方式（不填：有 SQL_USER 用 sql，沒有用 windows）
#   windows             Windows 整合驗證（目前登入的帳號）
#   sql                 SQL Server 帳號密碼
#   entra-interactive   Microsoft Entra（Azure AD）跳出登入視窗，支援 MFA。雲端最常用
#   entra-password      Entra 帳號密碼（沒有 MFA 的帳號）
#   entra-integrated    Entra 整合驗證（加入網域、已同步到 Entra 的電腦）
#   entra-msi           Azure 上的受控識別（程式跑在 Azure VM／App 上時）
SQL_AUTH=
SQL_USER=

# 密碼建議不要寫在這裡：留空的話，執行時會問（打字不顯示）。
# 只有排程這種沒人能輸入的情況才填，而且這台機器的 .env 要限制只有自己讀得到。
SQL_PASSWORD=

# 伺服器是自簽憑證、連線被「憑證鏈結是由不受信任的授權單位發出」擋下來時才改成 yes。
# 連線仍然加密，但不驗證對方是不是真的那台伺服器。雲端（Azure SQL）不要開。
SQL_TRUST_CERT=no

# 空白 = 自動挑機器上版本最高的 ODBC Driver（17、18 都可以）
SQL_DRIVER=
