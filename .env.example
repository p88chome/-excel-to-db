# 複製成 .env，填上這台機器要連的 SQL Server。
# .env 不進版控（見 .gitignore），所以密碼不會被推上 GitHub。
#
# 只要填了 SQL_SERVER 與 SQL_DATABASE，就會蓋掉 config.json 裡的 conn，
# 不必再去改 config.json。exe 版也讀，.env 放在 exe 旁邊即可。

SQL_SERVER=主機名稱或IP,1433
SQL_DATABASE=資料庫名稱

# Windows 整合驗證（用目前登入的帳號）：下面兩行留空。
# SQL 驗證：填帳號密碼。密碼裡的 @ : / 不用跳脫，程式會自己編碼。
SQL_USER=
SQL_PASSWORD=

# ODBC Driver 18 起預設強制加密，並且會驗證伺服器憑證。
# 內部的 SQL Server 多半是自簽憑證，會被擋下來，連線報
# 「SSL Provider / 憑證鏈結是由不受信任的授權單位發出」。
#
# 正解是請 DBA 換上受信任的憑證。做不到就把下面這行改成 yes，
# 連線仍然加密，但不再驗證對方是不是真的那台伺服器（擋不住中間人）。
# 內網通常可以接受，對外連線不要這樣設。
SQL_TRUST_CERT=no

# 空白就自動挑機器上裝的、版號最高的驅動（17、18 都適用）。
# 只有要指定特定版本時才填。名字要跟 ODBC 管理員裡顯示的一字不差。
SQL_DRIVER=

# 上面幾行組不出你要的字串時，用這行整條寫死，會蓋掉上面所有設定。
# SQL_CONN=mssql+pyodbc://帳號:密碼@主機/資料庫?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
